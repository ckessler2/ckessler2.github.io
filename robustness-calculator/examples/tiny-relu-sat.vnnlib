; Unsafe if Y_0 exceeds Y_1 by a margin that some inputs reach (sat).
; Network: tiny-relu.onnx (2 inputs, two hidden layers of 8 ReLUs, 2 outputs).
; Generated by tests/make-examples.js.

(declare-const X_0 Real)
(declare-const X_1 Real)
(declare-const Y_0 Real)
(declare-const Y_1 Real)

(assert (>= X_0 -1))
(assert (<= X_0 1))
(assert (>= X_1 -1))
(assert (<= X_1 1))

; Grid search found max(Y_0 - Y_1) = 0.101213; the threshold is 95% of it.
(assert (>= (- Y_0 Y_1) 0.0961519))
